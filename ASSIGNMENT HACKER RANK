import java.util.*;

public class Solution {

    static class State implements Comparable<State> {
        int node, mask, dist;

        State(int node, int mask, int dist) {
            this.node = node;
            this.mask = mask;
            this.dist = dist;
        }

        public int compareTo(State other) {
            return this.dist - other.dist;
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int m = sc.nextInt();
        int k = sc.nextInt();

        int[] fishMask = new int[n];

        // Read fish types
        for (int i = 0; i < n; i++) {
            int t = sc.nextInt();
            int mask = 0;
            for (int j = 0; j < t; j++) {
                int fish = sc.nextInt() - 1;
                mask |= (1 << fish);
            }
            fishMask[i] = mask;
        }

        // Graph
        ArrayList<int[]>[] graph = new ArrayList[n];
        for (int i = 0; i < n; i++) {
            graph[i] = new ArrayList<int[]>();
        }

        for (int i = 0; i < m; i++) {
            int u = sc.nextInt() - 1;
            int v = sc.nextInt() - 1;
            int w = sc.nextInt();

            graph[u].add(new int[]{v, w});
            graph[v].add(new int[]{u, w});
        }

        int maxMask = 1 << k;
        int[][] dist = new int[n][maxMask];

        for (int i = 0; i < n; i++) {
            Arrays.fill(dist[i], Integer.MAX_VALUE);
        }

        PriorityQueue<State> pq = new PriorityQueue<State>();

        int startMask = fishMask[0];
        dist[0][startMask] = 0;
        pq.add(new State(0, startMask, 0));

        // Dijkstra
        while (!pq.isEmpty()) {
            State cur = pq.poll();

            if (cur.dist > dist[cur.node][cur.mask]) continue;

            for (int[] edge : graph[cur.node]) {
                int next = edge[0];
                int w = edge[1];

                int newMask = cur.mask | fishMask[next];
                int newDist = cur.dist + w;

                if (newDist < dist[next][newMask]) {
                    dist[next][newMask] = newDist;
                    pq.add(new State(next, newMask, newDist));
                }
            }
        }

        int result = Integer.MAX_VALUE;

        // Combine paths
        for (int i = 0; i < maxMask; i++) {
            for (int j = 0; j < maxMask; j++) {
                if ((i | j) == (maxMask - 1)) {
                    int time = Math.max(dist[n - 1][i], dist[n - 1][j]);
                    if (time < result) {
                        result = time;
                    }
                }
            }
        }

        System.out.println(result);
    }
}

